# Copy this file to .env and fill in your own values.
# .env is git-ignored, so nothing you put there is published.
# It is only read by local_api.py; the deployed Lambda gets its settings from Terraform.
#
# AWS access keys do NOT belong here. Run `aws configure` once and boto3 will
# pick the credentials up from your AWS CLI configuration.

# Which AWS CLI profile and region to use for real Rekognition calls.
# AWS_PROFILE=my-profile
AWS_DEFAULT_REGION=ap-southeast-2

# Rekognition Custom Labels model (contains your AWS account id).
# Leave unset to use general label detection.
# REKOGNITION_MODEL_ARN=arn:aws:rekognition:ap-southeast-2:111122223333:project/my-project/version/my-version/1700000000000

# MIN_CONFIDENCE=50
